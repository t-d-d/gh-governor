{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "governor config file",
  "description": "The shape of governor's config file, .github/dispatch.json, for an editor to complete and check keys while the file is written. It covers the shape only: it leaves out the rules across keys and the checks on a prompt's text or a prompt file's path, and cannot read prompt files, so a file it accepts can still be refused. The config check, the reusable workflow .github/workflows/config-check.yml in t-d-d/gh-governor, is the full check.",
  "type": "object",
  "properties": {
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "labels": {
      "type": "object",
      "properties": {
        "ready": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[^,]*$"
          }
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[^,]*$"
        },
        "claimRemoves": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[^,]*$"
          }
        },
        "exclude": {
          "default": [
            "type: prd"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[^,]*$"
          }
        }
      },
      "required": [
        "ready",
        "claim"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "pickup": {
          "type": "boolean"
        },
        "summons": {
          "type": "boolean"
        },
        "prMessages": {
          "type": "boolean"
        },
        "subscribeMessages": {
          "type": "boolean"
        },
        "redScheduledRun": {
          "type": "boolean"
        },
        "mergeHandoff": {
          "type": "boolean"
        },
        "ciMessages": {
          "type": "boolean"
        },
        "deployMessages": {
          "type": "boolean"
        },
        "branchRunMessages": {
          "type": "boolean"
        },
        "conflicts": {
          "type": "boolean"
        },
        "deployedLabels": {
          "type": "boolean"
        },
        "prReview": {
          "type": "boolean"
        },
        "heartbeat": {
          "type": "boolean"
        },
        "periodics": {
          "type": "boolean"
        },
        "hooks": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "prompts": {
      "default": {},
      "type": "object",
      "properties": {
        "pickup": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "signOff": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "mergeHandoff": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "mergeHandoffUnread": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "redScheduledRun": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "ciBreaker": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "ciTriage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "ciBumpTriage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "prodTriage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "deployGreen": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "deployGreenMany": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "deployRed": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "deployRedMany": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "subscribed": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "conflicts": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "workflows": {
      "default": {
        "triage": [],
        "tags": {}
      },
      "type": "object",
      "properties": {
        "ci": {
          "type": "string",
          "pattern": "^\\.github\\/workflows\\/[\\w.-]+\\.ya?ml$"
        },
        "triage": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\n,]*$"
          }
        },
        "tags": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\n,]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\w./-]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "checklist": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          ]
        },
        "humanOnly": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "glob": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "unless": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50,
                  "pattern": "^[^,]*$"
                }
              }
            },
            "required": [
              "glob",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "tickets": {
          "default": {
            "require": [],
            "forbid": []
          },
          "type": "object",
          "properties": {
            "require": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "labels": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50,
                      "pattern": "^[^,]*$"
                    }
                  },
                  "unless": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50,
                      "pattern": "^[^,]*$"
                    }
                  }
                },
                "required": [
                  "labels"
                ],
                "additionalProperties": false
              }
            },
            "forbid": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "labels": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50,
                      "pattern": "^[^,]*$"
                    }
                  },
                  "unless": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50,
                      "pattern": "^[^,]*$"
                    }
                  }
                },
                "required": [
                  "labels"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "quote": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^!?[^!\\s]"
          }
        },
        "decides": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[^,]*$"
          }
        },
        "dependabot": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "merge": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "checklist"
      ],
      "additionalProperties": false
    },
    "heartbeat": {
      "type": "object",
      "properties": {
        "issue": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "marker": {
          "type": "string",
          "pattern": "^<!--[^\\n]*-->$"
        }
      },
      "required": [
        "issue"
      ],
      "additionalProperties": false
    },
    "pickup": {
      "type": "object",
      "properties": {
        "sweepHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "periodics": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\n]*$"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "file"
                ],
                "additionalProperties": false
              }
            ]
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "counts": {
            "type": "object",
            "properties": {
              "merges": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "issuesOpened": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "issuesClosed": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "gapHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "prompt",
          "days"
        ],
        "additionalProperties": false
      }
    },
    "hooks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "file"
                ],
                "additionalProperties": false
              }
            ]
          },
          "keyVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 999999999
          }
        },
        "required": [
          "name",
          "prompt",
          "keyVersion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "environment",
    "labels",
    "features"
  ],
  "additionalProperties": false
}
